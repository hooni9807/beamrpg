rules_version = '2';
// BeamRPG (project beamrpg-e22ac). Only cloud saves: saves/{uid} holds one player's RPG progress (see cloud.js).
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'rev', 'level', 'at'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000
        && request.resource.data.rev is int && request.resource.data.level is int
        && request.resource.data.at == request.time;
    }
  }
}
